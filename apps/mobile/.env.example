# Local Expo web on the same computer:
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Physical phone on the same Wi-Fi as your computer:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.99:4000/api/v1

# Production or preview APK with hosted backend:
# EXPO_PUBLIC_API_BASE_URL=https://your-hosted-backend-url.com/api/v1
