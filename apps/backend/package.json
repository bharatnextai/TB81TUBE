{
  "name": "@tb81tube/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:auth": "tsx src/scripts/authSmokeTest.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
